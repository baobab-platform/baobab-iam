{
  "clientId": "baobab-erp-workload",
  "name": "Baobab ERP Workload",
  "description": "Workload identity for the ERP engine (Gate IAM-10: erp:integrate; shared#206: erp:read, erp:provision). Tenant-neutral, no tenant_id: tenant entitlement is a Control Plane decision (ADR-0007 sections 88-91).",
  "enabled": true,
  "publicClient": false,
  "bearerOnly": false,
  "serviceAccountsEnabled": true,
  "protocol": "openid-connect",
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "standardFlowEnabled": false,
  "attributes": {
    "oauth2.device.authorization.grant.enabled": "false",
    "backchannel.logout.session.required": "false",
    "backchannel.logout.revoke.offline.tokens": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "defaultClientScopes": [
    "web-origins",
    "acr",
    "profile",
    "email",
    "roles",
    "openid",
    "actor-type-workload",
    "context:resolve",
    "erp:integrate",
    "erp:read",
    "erp:provision"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ]
}
