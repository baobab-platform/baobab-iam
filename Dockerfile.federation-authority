FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY cmd/federation-authority/ ./cmd/federation-authority/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /federation-authority ./cmd/federation-authority

FROM scratch
COPY --from=build /federation-authority /federation-authority
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/federation-authority"]
