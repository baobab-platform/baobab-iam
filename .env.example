# .env.example – configuration reference only; use make local-credentials for local credentials.
# Never commit generated credentials. No default password is supplied.

# Provider bootstrap only: this does not grant CP/tenant/native Kratos administration.
BAOBAB_ENVIRONMENT=local
# Keycloak admin credentials (used by bootstrap script)
KEYCLOAK_ADMIN=baobab-local-bootstrap
KEYCLOAK_ADMIN_PASSWORD=

# Database
POSTGRES_USER=baobab_iam
POSTGRES_PASSWORD=
POSTGRES_DB=baobab_iam

# Keycloak database connection
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/baobab_iam
KC_DB_USERNAME=baobab_iam
KC_DB_PASSWORD=

# Keycloak hostname (for local)
KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8080
KC_HOSTNAME_STRICT=false

# Logging
KC_LOG_LEVEL=INFO

# Workload client secrets – these are placeholders; the bootstrap script can auto‑generate them.
# In production, inject these from your secret manager.
BAOBAB_TRADE_SECRET=
BAOBAB_ERP_SECRET=
BAOBAB_CMS_SECRET=
BAOBAB_PULSE_SECRET=
ZURIBEANS_BACKEND_SECRET=
THAMANI_BACKEND_SECRET=